device LPC1765
si SWD
speed 4000
SetRESET
sleep 200
connect
ClrRESET
sleep 200
connect
; MEMMAP=1：映射用户 Flash（默认停在 Boot ROM 时 0x0 是 Boot ROM）
w4 0x400FC040, 1
; 烧前自动备份 256KiB 原 Flash（铁律：不备份不擦除）
savebin backup\pre_flash.bin, 0x0, 0x40000
erase
loadbin firmware\firmware.bin, 0x0
verifybin firmware\firmware.bin, 0x0
SetRESET
sleep 200
ClrRESET
sleep 200
go
sleep 500
exit
